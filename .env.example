# autotok settings. Copy this file to `.env` and fill in what you use:
#
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env
#
# `autotok` reads .env from the folder you run it in, then ~/.autotok/.env.
# Variables already set in your environment win over the file. `docker compose`
# reads the same file for the web app.
#
# Never commit .env: it holds API keys. It's already in .gitignore.

# ---- Where the login and signing browser runs -------------------------------
#   local        Chromium on this machine (run `autotok install-browser` once)
#   browserbase  Browserbase cloud browsers (needs BROWSERBASE_API_KEY)
#   steel        Steel Cloud (STEEL_API_KEY) or your own steel-browser (STEEL_BASE_URL)
# You can also choose per command: autotok --browser browserbase ...
AUTOTOK_BROWSER=local

# Browserbase: https://www.browserbase.com → Settings → API keys
BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=           # optional, inferred from the key
# BROWSERBASE_REGION=               # optional, e.g. eu-central-1 (pick the one nearest you)
# BROWSERBASE_PROXY_COUNTRY=        # paid plans: log in through a home IP in this country, e.g. GB

# Steel Cloud: set STEEL_API_KEY (https://steel.dev).
# Self-hosted steel-browser: set STEEL_BASE_URL and leave STEEL_API_KEY empty.
# Start the server with DOMAIN=localhost:3000 or its live view can't connect:
#   docker run -p 3000:3000 -e DOMAIN=localhost:3000 ghcr.io/steel-dev/steel-browser
STEEL_API_KEY=
STEEL_BASE_URL=
# STEEL_CONNECT_URL=                # optional CDP endpoint override

# ---- Files and local browser ------------------------------------------------
# AUTOTOK_HOME=~/.autotok           # saved accounts
# AUTOTOK_VIDEOS_DIR=~/.autotok/videos
# AUTOTOK_BROWSER_CHANNEL=chrome    # use your installed Google Chrome locally
# AUTOTOK_BROWSER_PATH=             # or a full path to a Chrome/Chromium binary

# ---- Web app (docker compose) -----------------------------------------------
# docker-compose.yml already sets these for its containers; change them only
# for custom setups.
# TIKTOK_API_DB_PATH=/data/tiktok.db
# NOVNC_CONTROL_URL=http://novnc:7900
# NOVNC_PUBLIC_URL=/novnc/vnc.html
# API_PUBLIC_URL=http://api:8000
# AUTOTOK_CALLBACK_SECRET=          # random and saved in $AUTOTOK_HOME if unset
# SCHEDULER_POLL_SECONDS=30
# LOG_LEVEL=INFO
