# Optional settings. The CLI and Python package read these from the environment;
# docker-compose.yml sets the container values itself.

# Where autotok keeps saved accounts (default: ~/.autotok).
# AUTOTOK_HOME=~/.autotok

# Folder for videos and YouTube downloads (default: $AUTOTOK_HOME/videos).
# AUTOTOK_VIDEOS_DIR=~/.autotok/videos

# Use your installed Google Chrome instead of Playwright's Chromium for login
# and signing (either the channel name or a full path to the binary).
# AUTOTOK_BROWSER_CHANNEL=chrome
# AUTOTOK_BROWSER_PATH=/usr/bin/google-chrome

# ---- Web app (api / scheduler / novnc) ----

# SQLite file. Defaults to /data/tiktok.db in containers, ./data/tiktok.db locally.
# TIKTOK_API_DB_PATH=/data/tiktok.db

# Where the api container reaches the noVNC control server.
# NOVNC_CONTROL_URL=http://novnc:7900

# URL the webapp iframe uses for noVNC. "/novnc/vnc.html" assumes nginx
# proxying; "http://localhost:6080/vnc.html" works for dev without nginx.
# NOVNC_PUBLIC_URL=/novnc/vnc.html

# URL the noVNC control server POSTs the captured session to.
# API_PUBLIC_URL=http://api:8000

# Secret used to sign login callbacks. If unset, a random one is generated and
# kept in $AUTOTOK_HOME/.callback_secret.
# AUTOTOK_CALLBACK_SECRET=

# How often the scheduler polls for due jobs (seconds).
# SCHEDULER_POLL_SECONDS=30

# Log level for the scheduler service.
# LOG_LEVEL=INFO
