{
    "name": "makiisthenes/autotok",
    "description": "Upload and schedule TikTok videos from PHP, through the autotok command line.",
    "type": "library",
    "keywords": ["tiktok", "upload", "video", "schedule", "autotok"],
    "homepage": "https://github.com/makiisthenes/TiktokAutoUploader",
    "license": "AGPL-3.0-only",
    "require": {
        "php": ">=8.1",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {"Autotok\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"Autotok\\Tests\\": "tests/"}
    },
    "scripts": {
        "test": "phpunit"
    }
}
